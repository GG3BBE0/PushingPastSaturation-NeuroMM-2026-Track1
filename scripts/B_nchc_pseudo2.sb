#!/bin/bash
# NCHC pseudo round-2 batch: AGGRESSIVE cwt/paul/filt @round-3 (public-gated 0.985 bet) + HONEST
# muku raw @round-1 (CV-gated diversity). 2xH100. 5 arch x 5 fold = 25 jobs.
#   transfer into $REPO_DIR before sbatch (MMDD_pseudo2_transfer.tar.gz unpacks these):
#     scripts/{build_pseudo_dataset.py,build_pseudo_dataset_iter.py,dispatcher_nchc_pseudo2.py,B_nchc_pseudo2.sb}
#     submissions/submission_test1_regnm_v3.zip        (round-1 source)
#     submissions/submission_test1_nchc_n2filt.zip     (round-3 source, 0.9778)
#     neuromm26_baseline/tools/{train_spec_concat_fold.py,train_muku_fold.py}  (have --noise-sids)
#   REQUIRES candidate caches on NCHC: NeuroMM-2026/candidate/candidate/{cwt,cwt_paul,cwt_filtered,eeg}/
#   then: sbatch scripts/B_nchc_pseudo2.sb
#SBATCH -A <your-project-id>
#SBATCH --job-name=neuromm_pseudo2
#SBATCH --output=logs/%x_%j.log
#SBATCH --error=logs/%x_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:2
#SBATCH --cpus-per-task=16
#SBATCH --mem=200G
#SBATCH --time=24:00:00
#SBATCH --partition=normal
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=<your-email>
set -euo pipefail

DO_INSTALL=0
WORK_ROOT=/work/<your-account>
REPO_DIR=$WORK_ROOT/NeuroMM-2026_Baseline
CONDA_ENV=neuromm26-baseline

ml purge; ml load cuda/12.4
source /work/HPC_software/LMOD/miniconda3/miniconda3_app/24.11.1/etc/profile.d/conda.sh
conda activate "$CONDA_ENV"
PY=$(which python)
echo "Job $SLURM_JOB_ID on $(hostname) GPUs=$CUDA_VISIBLE_DEVICES $(date)"; nvidia-smi --list-gpus
cd "$REPO_DIR"
[[ $DO_INSTALL -eq 1 ]] && pip install -e . --no-deps || true

# guards: train + candidate caches (concat needs cwt/paul/filt; muku needs eeg)
for s in cwt cwt_paul cwt_filtered eeg; do
  nt=$(ls "$REPO_DIR/neuromm26_datasets/processed/features/$s"/*.npy 2>/dev/null | wc -l) || true
  nc=$(ls "$REPO_DIR/NeuroMM-2026/candidate/candidate/$s"/*.npy 2>/dev/null | wc -l) || true
  echo "cache $s: train=${nt:-0} candidate=${nc:-0}"
  if [[ "${nt:-0}" -lt 25000 ]]; then echo "FATAL: train $s cache missing"; exit 1; fi
  if [[ "${nc:-0}" -lt 19000 ]]; then echo "FATAL: candidate $s cache missing -> scp it to NCHC first"; exit 1; fi
done

# build BOTH pseudo datasets on NCHC (symlinks candidate feats into train dirs)
echo "== building round-1 pseudo dataset (honest muku source) =="
$PY scripts/build_pseudo_dataset.py
echo "== building round-3 aggressive pseudo dataset (source=nchc_n2filt 0.9778, HI=0.80) =="
$PY scripts/build_pseudo_dataset_iter.py submissions/submission_test1_nchc_n2filt.zip r3 0.80 4
wc -l "$REPO_DIR"/fold_df_pseudo.csv "$REPO_DIR"/pseudo_sids.txt "$REPO_DIR"/fold_df_pseudo_r3.csv "$REPO_DIR"/pseudo_sids_r3.txt

# run the 25-job dispatcher (GPU 0,1)
REPO_DIR="$REPO_DIR" PY="$PY" $PY scripts/dispatcher_nchc_pseudo2.py
echo "Finished: $(date)"
# results: neuromm26_results/{predictions,checkpoints}/{concat_*_pseudo_r3nchc_fold__*, muku_pseudo_nchc_fold__*}
#   scp those back; integrate with append_arch_to_npz + gate_iter / build_nchc_submission.
