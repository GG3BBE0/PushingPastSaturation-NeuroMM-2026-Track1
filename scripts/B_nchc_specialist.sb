#!/bin/bash
# NCHC candidate-SPECIALIST batch (strategy-B, the 0.985 attempt). 2xH100. 5 arch x 5 fold = 25 jobs.
#   transfer into $REPO_DIR before sbatch (0609_specialist_transfer.tar.gz unpacks these):
#     scripts/{build_pseudo_dataset_iter.py,dispatcher_nchc_specialist.py,B_nchc_specialist.sb}
#     submissions/submission_test1_nchc_n2filt.zip   (the 0.9778 label source)
#     neuromm26_baseline/tools/{train_spec_concat_fold.py,train_muku_fold.py}
#   REQUIRES candidate caches on NCHC: NeuroMM-2026/candidate/candidate/{cwt,cwt_paul,cwt_filtered,superlet,eeg}/
#   then: sbatch scripts/B_nchc_specialist.sb
#SBATCH -A <your-project-id>
#SBATCH --job-name=neuromm_spec
#SBATCH --output=logs/%x_%j.log
#SBATCH --error=logs/%x_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:2
#SBATCH --cpus-per-task=16
#SBATCH --mem=200G
#SBATCH --time=24:00:00
#SBATCH --partition=normal
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=<your-email>
set -euo pipefail

WORK_ROOT=/work/<your-account>
REPO_DIR=$WORK_ROOT/NeuroMM-2026_Baseline
CONDA_ENV=neuromm26-baseline

ml purge; ml load cuda/12.4
source /work/HPC_software/LMOD/miniconda3/miniconda3_app/24.11.1/etc/profile.d/conda.sh
conda activate "$CONDA_ENV"
PY=$(which python)
echo "Job $SLURM_JOB_ID on $(hostname) GPUs=$CUDA_VISIBLE_DEVICES $(date)"; nvidia-smi --list-gpus
cd "$REPO_DIR"

# guards: concat needs cwt/paul/filt/superlet; muku needs eeg
for s in cwt cwt_paul cwt_filtered superlet eeg; do
  nt=$(ls "$REPO_DIR/neuromm26_datasets/processed/features/$s"/*.npy 2>/dev/null | wc -l) || true
  nc=$(ls "$REPO_DIR/NeuroMM-2026/candidate/candidate/$s"/*.npy 2>/dev/null | wc -l) || true
  echo "cache $s: train=${nt:-0} candidate=${nc:-0}"
  if [[ "${nt:-0}" -lt 25000 ]]; then echo "FATAL: train $s cache missing"; exit 1; fi
  if [[ "${nc:-0}" -lt 19000 ]]; then echo "FATAL: candidate $s cache missing -> scp it to NCHC first"; exit 1; fi
done

# build the specialist dataset on NCHC (11336 candidates labeled by nchc_n2filt, symlinks feats)
echo "== building candidate-specialist dataset (source=nchc_n2filt 0.9778, HI=0.60, neg bottom 35%) =="
$PY scripts/build_pseudo_dataset_iter.py submissions/submission_test1_nchc_n2filt.zip spec 0.60 35
wc -l "$REPO_DIR"/fold_df_pseudo_spec.csv "$REPO_DIR"/pseudo_sids_spec.txt

REPO_DIR="$REPO_DIR" PY="$PY" $PY scripts/dispatcher_nchc_specialist.py
echo "Finished: $(date)"
# results: neuromm26_results/{predictions,checkpoints}/{concat_*_specnchc_fold__*, muku_specnchc_fold__*}
#   scp back; build a SPECIALIST-DOMINANT submission (heavy weight on the specialists) -> probe public.
